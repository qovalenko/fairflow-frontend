{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../host/src/*"],
      "react": ["../../host/node_modules/@types/react"],
      "react/*": ["../../host/node_modules/@types/react/*"],
      "react-dom": ["../../host/node_modules/@types/react-dom"],
      "react-dom/*": ["../../host/node_modules/@types/react-dom/*"],
      "vitest": ["../../host/node_modules/vitest"],
      "vitest/*": ["../../host/node_modules/vitest/*"],
      "@testing-library/*": ["../../host/node_modules/@testing-library/*"]
    }
  },
  "include": ["src"]
}
