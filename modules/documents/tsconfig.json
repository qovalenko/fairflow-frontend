{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "typeRoots": ["../../host/node_modules/@types", "node_modules/@types"],
    "paths": {
      "@/*": ["../../host/src/*"],
      "@fairflow/slot-catalog": ["../../../../backend/shared/src/slot-catalog.ts"],
      "react": ["../../host/node_modules/@types/react"],
      "react/*": ["../../host/node_modules/@types/react/*"],
      "react-dom": ["../../host/node_modules/@types/react-dom"],
      "react-dom/*": ["../../host/node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "../../host/src/@types/federation-remotes.d.ts"]
}
