{
  "name": "@fairflow/host",
  "private": true,
  "version": "1.3.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test-gateway-local-remotes": "VITE_REMOTES_BASE_URL= VITE_API_PROXY_TARGET=https://stand.example.com VITE_AUTH_PERSIST_STRATEGY=localStorage VITE_API_PREFIX=/api vite",
    "dev:all:test-gateway-local-remotes": "bash ./dev-all-local-remotes-test-gateway.sh",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "allure:report": "allure generate ../allure-results -o ../allure-report --clean",
    "allure:open": "allure open ../allure-report",
    "allure:serve": "allure serve ../allure-results",
    "preview": "vite preview",
    "prettier": "npx prettier src --check",
    "prettier:fix": "npm run prettier -- --write",
    "lint": "npx eslint",
    "typecheck": "tsc --noEmit",
    "lint:fix": "npm run lint -- --fix",
    "format": "npm run prettier:fix && npm run lint:fix"
  },
  "dependencies": {
