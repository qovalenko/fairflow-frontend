# Copy to .env (gitignored) to override defaults. All are optional.

# App origin under test.
#   - local hybrid:  http://localhost:5173  (default)
#   - feature stand: https://<slug>.app.example
#   - deployed stand: set to your stand origin (a prod build strips data-qa-id,
#                    so the qa-id smoke needs the hybrid)
BASE_URL=http://localhost:5173

# REST API base. Default = BASE_URL + /api (same-origin; works through the host
# dev proxy in the hybrid). Override to hit a gateway directly.
# API_BASE_URL=http://localhost:3000/api

# Admin credentials (default admin@fairflow.local / admin).
# E2E_EMAIL=admin@fairflow.local
# E2E_PASSWORD=admin

# Enable the pending deals smoke (needs a hybrid serving the deals remote locally
# with qa-ids). See tests/05-create-deal.spec.ts.
# E2E_DEALS=1
